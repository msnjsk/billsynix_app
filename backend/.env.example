# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
LOG_LEVEL=debug

# docker compose exposes PostgreSQL on 5433 so it doesn't clash with a local 5432.
# The API connects as the least-privilege role (row-level security applies to it)…
DATABASE_URL=
# …and migrations run as the schema owner (also use this when DATABASE_URL goes through a pooler).
#DIRECT_URL=
# End-to-end tests use their own database (created by docker/initdb). Tests wipe it.
#TEST_DATABASE_URL=
#TEST_DIRECT_URL=

# Access-token signing secret — at least 32 random characters in production.
# (Refresh tokens are opaque random values stored hashed, so there is no refresh secret.)
JWT_ACCESS_SECRET=

# Rate limits per client IP (per minute). Set TRUST_PROXY=true behind a load balancer.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY=false

# Password-reset emails. Until an email provider is added (Phase 11) messages are only logged
# (and, in production, not even their contents).
MAIL_FROM=Billing <no-reply@billing.local>

# Later phases
REDIS_URL=

# Uploaded files (product photos). `local` writes under STORAGE_LOCAL_DIR; `s3` uses any
# S3-compatible store (AWS S3, Cloudflare R2, MinIO) — the bucket stays private.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Subscription payments (Phase 10). `none` until a gateway account exists: checkout then answers
# 503 PAYMENTS_NOT_CONFIGURED. With `razorpay`, all three keys are required; point the Razorpay
# webhook at  https://<api>/api/v1/webhooks/payments/razorpay  (events payment.captured,
# payment.failed, order.paid) with the same webhook secret.
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated browser origins allowed to call the API.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,kirana://pos

SWAGGER_ENABLED=true
SENTRY_DSN=
